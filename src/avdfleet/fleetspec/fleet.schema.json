{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avdfleet.example/schemas/fleet.schema.json",
  "title": "AVD Fleet fleet.yaml",
  "description": "Declarative fleet definition reconciled by `avdfleet fleet apply`.",
  "type": "object",
  "required": ["apiVersion", "kind", "name"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "avdfleet/v1" },
    "kind": { "type": "string", "const": "Fleet" },
    "name": { "type": "string", "minLength": 1, "maxLength": 63 },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 64, "default": 64 },
    "settings": {
      "type": "object",
      "additionalProperties": true
    },
    "proxies": {
      "type": "array",
      "items": { "$ref": "#/$defs/proxy" },
      "default": []
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/template" }
    },
    "instances": {
      "type": "array",
      "items": { "$ref": "#/$defs/instance" }
    }
  },
  "allOf": [
    {
      "description": "Instance template references must resolve.",
      "if": { "required": ["instances", "templates"] },
      "then": {
        "x-cross-validation": "instance.template must name a template in templates; instance.proxy must name a proxy in proxies"
      }
    }
  ],
  "$defs": {
    "proxy": {
      "type": "object",
      "required": ["id", "host", "port"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "scheme": { "type": "string", "enum": ["http", "https", "socks5"], "default": "http" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "username": { "type": ["string", "null"] },
        "password_env": {
          "type": ["string", "null"],
          "description": "Environment variable containing the password; never the password itself."
        },
        "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "template": {
      "type": "object",
      "required": ["name", "image"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "image": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "default": "pixel_7" },
        "ram_mb": { "type": "integer", "minimum": 512, "maximum": 16384, "default": 2048 },
        "cpu_cores": { "type": "integer", "minimum": 1, "maximum": 16, "default": 2 },
        "heap_mb": { "type": "integer", "minimum": 16, "maximum": 4096, "default": 256 },
        "gpu_mode": {
          "type": "string",
          "enum": ["auto", "host", "swiftshader_indirect", "swiftshader", "angle_indirect", "off"],
          "default": "swiftshader_indirect"
        },
        "headless": { "type": "boolean", "default": true },
        "proxy": { "type": ["string", "null"] },
        "scripts": { "type": "array", "items": { "type": "string" }, "default": [] },
        "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "instance": {
      "type": "object",
      "required": ["name", "template"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,63}$" },
        "template": { "type": "string" },
        "proxy": { "type": ["string", "null"] },
        "ram_mb": { "type": ["integer", "null"], "minimum": 512 },
        "metadata": { "type": "object", "additionalProperties": true, "default": {} }
      }
    }
  },
  "examples": [
    {
      "apiVersion": "avdfleet/v1",
      "kind": "Fleet",
      "name": "demo",
      "capacity": 8,
      "proxies": [
        {
          "id": "proxy-1",
          "scheme": "http",
          "host": "127.0.0.1",
          "port": 8081,
          "username": "fleet",
          "password_env": "AVDFLEET_PROXY_1_PASSWORD"
        }
      ],
      "templates": [
        {
          "name": "pixel-api35",
          "image": "system-images;android-35;google_apis_playstore;x86_64",
          "device": "pixel_7",
          "ram_mb": 4096,
          "proxy": "proxy-1"
        }
      ],
      "instances": [
        { "name": "avd-01", "template": "pixel-api35" },
        { "name": "avd-02", "template": "pixel-api35" },
        { "name": "avd-03", "template": "pixel-api35" }
      ]
    }
  ]
}
