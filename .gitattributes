# Normalize text files in the repository. Shell scripts must use LF on every
# platform (bootstrap tests check byte-for-byte); PowerShell scripts must use
# CRLF so the Windows launcher parser and the bootstrap tests agree.
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.lock text eol=lf
