# AVD Fleet GUI environment flags (all optional).

# Mock Service Worker layer. In `vite dev`, mocks are ON unless this is "false".
# Set to "false" to talk to a real `avdfleet serve` daemon through the Vite proxy
# (http://127.0.0.1:8765). Builds never enable mocks unless explicitly set.
VITE_USE_MOCKS=true

# Override the REST base URL (default: /api/v1 on the same origin).
# VITE_API_BASE_URL=http://127.0.0.1:8765/api/v1

# Override the WebSocket events URL (default: same-origin /ws/events).
# VITE_WS_URL=ws://127.0.0.1:8765/ws/events
